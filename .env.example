# Copia este archivo como ".env" y llena los valores.

# Usuario dedicado para las pruebas, ya confirmado en Supabase Auth.
# No uses tu cuenta personal: la prueba de logout cierra TODAS las sesiones
# de este usuario (Supabase cierra sesión de forma global).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Opcional: apunta las pruebas a una app ya desplegada. Si se define,
# Playwright no levanta el servidor local de Bitacora360WebProyect.
# BASE_URL=http://localhost:3000
