# Copia este archivo como ".env" y llena los valores.

# Usuario dedicado para las pruebas, ya confirmado en Supabase Auth.
# No uses tu cuenta personal: la prueba de logout cierra TODAS las sesiones
# de este usuario (Supabase cierra sesión de forma global).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Opcional: API key de Mailsac. Con ella corren las pruebas de registro con
# correo real (tests/auth/register-email.spec.ts); sin ella se saltan solas.
# MAILSAC_API_KEY=

# Opcional: permite que esas pruebas borren los usuarios que crean. La URL es
# la misma que NEXT_PUBLIC_SUPABASE_URL en la app. La clave de servicio se
# salta las políticas RLS: nunca la subas al repositorio.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Opcional: apunta las pruebas a una app ya desplegada. Si se define,
# Playwright no levanta el servidor local de Bitacora360WebProyect.
# BASE_URL=http://localhost:3000
