{
  "name": "bitacora360-automation-testing",
  "version": "0.1.0",
  "private": true,
  "description": "Pruebas automatizadas E2E de Bitácora360 con Playwright",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "playwright test",
    "test:auth": "playwright test --project=auth",
    "test:dashboard": "playwright test --project=dashboard",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "report:allure": "allure open allure-results",
    "codegen": "playwright codegen http://localhost:3000",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "allure": "^3.20.0",
    "allure-playwright": "^3.13.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
